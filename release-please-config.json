{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/ecowater_cloud/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='ha-ecowater-cloud')].version"
        }
      ]
    }
  }
}
