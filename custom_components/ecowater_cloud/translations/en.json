{
  "config": {
    "step": {
      "user": {
        "title": "[%key:common::config_flow::title::connect%]",
        "description": "Enter your EcoWater cloud account email and password.",
        "data": {
          "username": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]",
          "region": "Region"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The password for {username} is invalid or has expired. Please enter your current password.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reconfigure": {
        "data": {
          "username": "Email",
          "password": "Password",
          "region": "Region"
        },
        "description": "Update your EcoWater credentials or region.",
        "title": "Reconfigure EcoWater Cloud"
      }
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "rate_limit": "Too many requests to the cloud. Please try again later.",
      "no_devices": "No supported devices found on this account.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "account_mismatch": "The account email cannot be changed during reconfiguration. Add a new EcoWater Cloud integration for a different account."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure EcoWater Cloud Options",
        "data": {
          "polling_interval_minutes": "Polling interval (minutes)"
        }
      }
    }
  },
  "issues": {
    "authentication_rejected": {
      "title": "EcoWater Cloud authentication failed",
      "description": "The EcoWater Cloud credentials for this integration were rejected. Go to the integration settings and use **Re-authenticate** to enter a new password."
    },
    "no_devices": {
      "title": "No EcoWater devices found",
      "description": "The EcoWater Cloud account was authenticated but no supported devices were found. Verify that your device appears in the EcoWater app and try reloading the integration."
    },
    "unknown_salt_model": {
      "title": "EcoWater device model not fully supported",
      "description": "The salt level percentage cannot be calculated for: {devices}. The device model is not yet mapped. Download diagnostics and open a GitHub issue to help add support."
    },
    "data_stale": {
      "title": "EcoWater device data is stale",
      "description": "The following device(s) have not sent fresh data to the cloud for an unusually long period: {devices}. This may indicate a connectivity issue with the device. Check that the device appears online in the EcoWater app."
    },
    "protocol_changed": {
      "title": "EcoWater Cloud API response changed",
      "description": "The EcoWater Cloud returned an unexpected response. This may indicate the API has changed. Please open a GitHub issue with diagnostics attached."
    }
  },
